        "    'Gender': ['Female', 'Male', 'Male', 'Male', 'Female', 'Male', 'Female', 'Female', 'Male', 'Female'],\n",
        "    'Salary': [60000, 75000, 80000, 62000, 90000, 55000, 70000, 68000, 82000, 63000],\n",
        "    'Experience': [2, 7, 10, 4, 15, 1, 6, 5, 12, 3],\n",
        "    'Rating': [4.2, np.nan, 3.9, 4.5, 4.8, 3.5, 4.1, np.nan, 3.7, 4.3]\n",
